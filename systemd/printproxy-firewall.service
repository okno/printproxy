[Unit]
Description=Scoped nftables rules for printproxy
After=network-pre.target printproxy-vip.service
Before=printproxy.service
PartOf=printproxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/printproxy-firewall up
ExecStop=/usr/local/libexec/printproxy-firewall down

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
