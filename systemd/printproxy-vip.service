[Unit]
Description=Add the dedicated printproxy virtual IPv4 address
Wants=network-online.target
After=network-online.target
Before=printproxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/printproxy-vip up
ExecStop=/usr/local/libexec/printproxy-vip down

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_PACKET

[Install]
WantedBy=multi-user.target
